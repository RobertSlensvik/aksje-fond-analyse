# Kopier denne til `.env` og fyll inn for å aktivere AI-assistenten (chat-boblen).
# `.env` er gitignored — nøkkelen havner ALDRI på GitHub. Del aldri nøkkelen.
#
# Få en API-nøkkel på https://console.anthropic.com (egen fakturering, ikke det
# samme som et claude.ai-abonnement). Uten nøkkel er boblen bare "av" og koster
# ingenting.

ANTHROPIC_API_KEY=sk-ant-...

# Valgfritt: overstyr modellen (default er den rimelige Haiku-modellen).
# CLAUDE_MODELL=claude-haiku-4-5-20251001

# ─── Docker (Linux) ─────────────────────────────────────────────────────────
# Må matche eieren av data/ på host, ellers nektes skriving. Finn med: id -u / id -g
UID=1000
GID=1000

# Hvem kan nå appen. 0.0.0.0 = hele nettverket, 127.0.0.1 = kun via SSH-tunnel.
# Appen har ingen autentisering — se DEPLOY.md før du eksponerer den.
BIND_ADDR=0.0.0.0
PORT=5001

TZ=Europe/Oslo

# Hvor ofte bakgrunnsjobben henter nyheter (4h, 30m, 900 …)
HENT_INTERVALL=4h
